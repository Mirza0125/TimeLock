{
  "name": "screenlimiter",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "e2e:skeleton": "bash scripts/e2e-skeleton.sh",
    "spike:block-launch": "bash scripts/spike-block-launch.sh",
    "verify:native:config": "bash scripts/verify-native-config.sh",
    "verify:native": "bash scripts/verify-native-config.sh && bash scripts/audit-apk-manifest.sh",
    "lint:kotlin": "bash scripts/gradle.sh :screen-guard:ktlintCheck",
    "format:kotlin": "bash scripts/gradle.sh :screen-guard:ktlintFormat",
    "test:kotlin": "bash scripts/gradle.sh :screen-guard:testDebugUnitTest",
    "lint": "eslint . --max-warnings 0 && node scripts/check-rtl-lint-rule.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "dependencies": {
    "@types/jest": "29.5.14",
    "eslint-config-expo": "~57.0.2",
    "expo": "~57.0.25",
    "expo-constants": "~57.0.19",
    "expo-linking": "~57.0.11",
    "expo-router": "~57.0.23",
    "expo-status-bar": "~57.0.1",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "prettier": "^3.9.9",
    "test-renderer": "^1.3.0",
    "typescript": "~5.9.3"
  },
  "packageManager": "pnpm@12.6.0+sha512.3ef68f951cb111ac204b4a5a16f0b2ddf0da56a96e0413e81d855d9f0b55ef926714709028e1cd00c405c2c5fb7b9e8ec4dc46777c805d0373c2f2ff00fd20ec"
}
